# Copy this file to .env and fill in what you need. Never commit .env.

# fal.ai API key. Only the server reads it; it is never sent to the browser.
# Leave empty to use the editor without generation (or use mock mode below).
FAL_KEY=

# Optional: a read-only fal key used ONLY to show your credit balance in the top
# bar (create it in fal's dashboard with the BILLING preset; it can't generate or
# spend). If empty, Shotloom tries FAL_KEY, which works only if that key can read
# billing. Server-only, like FAL_KEY. Not used in mock mode.
FAL_BILLING_KEY=

# Which provider handles NEW generations: "fal" (real, paid) or "mock" (local fake videos, free).
GENERATION_PROVIDER=mock

# Where film folders live. Relative paths resolve from this app folder.
FILMS_ROOT=./films

# Local server port. The server only listens on 127.0.0.1.
PORT=8787

# Optional: full paths if ffmpeg/ffprobe are not on PATH (Windows example below).
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
